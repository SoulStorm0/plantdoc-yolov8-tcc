    "batch": 16,
    "lr0": 0.0001,
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "strategies": ["baseline", "class_weighted", "focal"]
  },
  "search": {
    "epochs": 100,
    "trials": [
      {"batch": 16, "lr0": 0.001, "momentum": 0.9, "weight_decay": 0.0001},
      {"batch": 16, "lr0": 0.001, "momentum": 0.937, "weight_decay": 0.0005},
      {"batch": 32, "lr0": 0.001, "momentum": 0.937, "weight_decay": 0.001},
      {"batch": 16, "lr0": 0.0001, "momentum": 0.9, "weight_decay": 0.0005},
      {"batch": 16, "lr0": 0.0001, "momentum": 0.937, "weight_decay": 0.0001},
      {"batch": 32, "lr0": 0.0001, "momentum": 0.937, "weight_decay": 0.0005},
