{
  "project": "runs/integration",
  "model": "yolov8n.pt",
  "imgsz": 320,
  "seed": 42,
  "deterministic": true,
  "fraction": 0.05,
  "workers": 0,
  "optimizer": "SGD",
  "epochs": [1],
  "batch": [8],
  "lr0": [0.0001],
  "momentum": [0.937],
  "weight_decay": [0.0005],
  "lrf": 0.01,
  "warmup_epochs": 1.0,
  "warmup_momentum": 0.8,
  "cos_lr": true,
  "patience": 1,
  "loss_strategies": ["baseline", "class_weighted", "focal"],
  "class_weighting": {"method": "sqrt_inverse_frequency", "max_weight": 8.0},
  "focal": {"gamma": 2.0, "alpha": 0.25},
  "augmentation": {
    "fliplr": 0.5,
    "flipud": 0.2,
    "degrees": 15.0,
    "hsv_v": 0.2,
    "mosaic": 1.0,
    "close_mosaic": 0
  }
}
